# Copy to .env (next to compose.yaml) and fill in what you need.
# Everything is optional if you have exactly one Foundry resource and are
# signed in with `az login` on your machine.

# --- Foundry -----------------------------------------------------------------
# Name of your Azure AI Foundry (AIServices) resource. Auto-detected when your
# subscription has exactly one.
FOUNDRY_RESOURCE=
# Speeds up discovery; optional.
FOUNDRY_RESOURCE_GROUP=
# Deployment name pi should start with (default: best coding model found).
FOUNDRY_DEFAULT_MODEL=
# Comma-separated deployment names to hide from pi.
FOUNDRY_EXCLUDE=

# --- Azure identity ------------------------------------------------------------
# auto | host | device-code | service-principal | managed-identity
FOUNDRY_AUTH=auto
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
# Service principal / workload identity (CI, headless boxes)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_FEDERATED_TOKEN_FILE=

# --- Permissions -------------------------------------------------------------------
# Starting mode: ask (prompt before edits and commands), edits (edit freely,
# ask before commands), plan (read-only), auto (no prompts, pi's default).
# Shift+Tab cycles modes inside pi. Set FOUNDRY_PERMISSIONS=off to disable.
FOUNDRY_MODE=ask
FOUNDRY_PERMISSIONS=on

# --- Look ------------------------------------------------------------------------
# Default theme while you haven't picked one in /settings. A "light/dark" pair
# follows your terminal background. Set to "off" to use pi's built-in default.
FOUNDRY_THEME=foundry-light/foundry-dark

# --- Paths ---------------------------------------------------------------------------
# Where pi's config + sessions live on your machine.
PI_CONFIG_DIR=~/.pi-foundry/agent
# Your host az login dir (copied read-only). Point at an empty dir to disable.
AZURE_CONFIG_HOST_DIR=~/.azure

# --- Build -----------------------------------------------------------------------------
# pi version to install (`make build` resolves the newest release for you).
PI_VERSION=latest
# Extra Debian packages for your stack, e.g. "python3 python3-venv golang-go"
EXTRA_APT_PACKAGES=

# --- Network (corporate proxy / TLS inspection) -----------------------------------
HTTPS_PROXY=
NO_PROXY=
# Path *inside the container* to a PEM bundle (mount it via compose.override.yaml)
NODE_EXTRA_CA_CERTS=
REQUESTS_CA_BUNDLE=

# --- Git identity for agent commits -----------------------------------------------
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
